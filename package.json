{
  "name": "sti-assist-ai",
  "version": "1.0.0",
  "private": true,
  "description": "STI Assist AI - a handbook-grounded student assistant for STI High School",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "index": "node scripts/index-handbook.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check-config.js",
    "eval": "node scripts/eval-retrieval.js",
    "smoke": "node scripts/smoke-live.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "kv:upload": "node scripts/upload-index-kv.js --remote",
    "kv:upload:local": "node scripts/upload-index-kv.js --local"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
