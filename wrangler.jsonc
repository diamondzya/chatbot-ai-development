{
  // Cloudflare Workers configuration for STI Assist AI.
  //
  // The Worker runs the existing Express application (src/app.js) through the
  // node:http integration, serves the frontend with Workers Static Assets, and
  // reads the generated handbook index from the HANDBOOK_INDEX KV namespace.
  //
  // Deployment:
  //   npx wrangler kv namespace create HANDBOOK_INDEX   (once; put the id below)
  //   npm run kv:upload                                 (upload data/index.json)
  //   npx wrangler secret put AI_API_KEY                (once per secret)
  //   npx wrangler secret put EMBEDDING_API_KEY         (optional; falls back to AI_API_KEY)
  //   npx wrangler deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sti-assist-ai",
  "main": "worker/index.js",

  // Compatibility date >= 2026-08-04 enables nodejs_compat (and the node:http
  // server needed for Express) by default; the flag below is kept explicit for
  // clarity and for older tooling. 2026-10-30 is the newest date supported by
  // the current workerd binary used by `wrangler dev`.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // Frontend files. Wrangler uploads public/ to Cloudflare's static asset
    // system; the Worker gets the ASSETS binding to serve them.
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* always reaches the Worker (and therefore Express). Everything
    // else is served straight from the asset system when a file matches.
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "HANDBOOK_INDEX",
      // Replace with the id printed by:
      //   npx wrangler kv namespace create HANDBOOK_INDEX
      // Local `wrangler dev` works with this placeholder; `wrangler deploy`
      // requires the real id.
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  // Public (non-secret) configuration. Secrets are set with `wrangler secret
  // put` and live only in the Worker environment: AI_API_KEY and, optionally,
  // EMBEDDING_API_KEY.
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    // Query-time semantic search in the Worker requires provider embeddings:
    // the index must have been built with EMBEDDING_PROVIDER=nvidia. A locally
    // embedded index still works, but retrieval falls back to BM25 keywords.
    "EMBEDDING_PROVIDER": "nvidia"
  },

  "observability": {
    "enabled": true
  }
}
