# Security headers for static assets served by Cloudflare Workers Static Assets.
#
# On the local Node server these headers come from Helmet (src/app.js); this
# file gives the asset-served HTML/CSS/JS the same protections on Workers,
# where the assets system answers before Express runs. Keep the two in sync
# when the Helmet configuration changes.
#
# `upgrade-insecure-requests` is deliberately omitted so `wrangler dev` on
# plain http://localhost keeps working; production Workers are always HTTPS.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin
