{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sti-assist-ai",
  "pages_build_output_dir": "../public",
  "compatibility_date": "2026-10-30",
  // Requests keep their Pages URL and Origin. The backend's same-origin
  // validation and streaming responses work through this internal binding.
  "services": [
    { "binding": "CHAT_API", "service": "sti-assist-ai" }
  ]
}
