# -----------------------------------------------------------------------------
# STI Assist AI - environment template
#
# Copy this file to .env and fill in real values:  cp .env.example .env
# NEVER put a real key in THIS file - .gitignore keeps .env.example committable
# on purpose, so anything here can end up in version control.
# -----------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# info or silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# AI provider
# AI_PROVIDER=nvidia uses NVIDIA NIM's OpenAI-compatible API.
# AI_PROVIDER=openai-compatible also works with OpenAI, Groq, Together, etc.
# The app runs in a clearly labelled local retrieval demo if no key is set.
# -----------------------------------------------------------------------------
AI_PROVIDER=nvidia
AI_API_KEY=replace_with_your_actual_key
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Chat model. Must be a model your account can access.
#
# Measured against integrate.api.nvidia.com with a realistic grounded handbook
# prompt (latency / hidden reasoning tokens / answer complete):
#   deepseek-ai/deepseek-v4.1-flash        10s    86 reasoning  complete   <- default
#   nvidia/nemotron-3.5-bolt-e4b           1.1s   0 reasoning   complete
#   meta/llama-3.2-11b-vision-instruct     2.5s   0 reasoning   complete
#   nvidia/nemotron-3.5-lightning-30b-a3b  7.4s   593 reasoning truncated
#   nvidia/nemotron-3-ultra-550b-a55b      49s    0 reasoning   complete
#   openai/gpt-oss-20b                     175s   0 reasoning   truncated
#
# Prefer a model that answers directly. A reasoning model bills its hidden
# chain-of-thought against AI_MAX_OUTPUT_TOKENS, which starves the visible
# answer; the app detects that and labels the reply as incomplete. DeepSeek
# reasons silently first, so the visible stream starts after ~7 s even when the
# total is similar to the direct-answer models. Retired models return HTTP 410,
# and the app reports that instead of failing silently. Model availability
# changes, so re-check if one stops working.
AI_MODEL=deepseek-ai/deepseek-v4.1-flash

# Vision model. These IDs are valid, but as of 2026-10-28 NVIDIA's hosted vision
# models fail on EVERY request that contains an image (502 / hang / 400) while
# answering text-only requests normally. See "Vision behavior" in README.md.
# Kept as the default for when that endpoint is fixed, or when AI_PROVIDER is
# pointed at a provider whose vision API actually works.
AI_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# How long a provider request may go without progress before it is aborted.
# Streaming answers reset this clock whenever the provider sends data, so a
# slow reasoning model is not cut off while it is still working. A request
# that stalls without any data is retried once before the student sees an
# error.
AI_TIMEOUT_MS=45000
# How long to wait for image analysis before telling the student to type the
# text instead. Image requests are slower than text ones.
AI_VISION_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=900
AI_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Retrieval embeddings
# local  = offline sentence embeddings using Transformers.js (recommended)
# nvidia = NVIDIA NIM embedding endpoint (uses AI_API_KEY unless overridden)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_TIMEOUT_MS=30000

# Set to false if the local embedding runtime is unavailable or you want to
# diagnose retrieval with BM25 keyword search only.
ENABLE_DENSE_RETRIEVAL=true

# -----------------------------------------------------------------------------
# Handbook
# Keep the PDF in its existing location. Relative paths are from project root.
# Run `npm run index` after changing the handbook or embedding model.
# -----------------------------------------------------------------------------
HANDBOOK_PATH=STI High School Student Handbook 2026 (ORCA).pdf

# Serve the indexed handbook at /handbook.pdf so source cards can deep-link to
# the cited page (for example /handbook.pdf#page=40). This makes the whole PDF
# downloadable by anyone who can reach the app. Set to false when the deployment
# does not have redistribution rights; citations still show the text excerpts.
SERVE_HANDBOOK_PDF=true

# Request limits (bytes)
MAX_IMAGE_MB=6
MAX_MESSAGE_CHARS=2000

# How long uploaded images stay in server memory (minutes). They are never
# written to disk, and they are deleted when this timer expires.
ATTACHMENT_TTL_MINUTES=30

# Rate limits (per IP address)
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_10_MINUTES=12

# Set this only if the app is behind a trusted reverse proxy (for correct IPs
# in rate limiting). Use the number of trusted proxy hops, for example 1.
# TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Unanswered-question log ("coverage gaps")
# When an answer ends in the "I couldn't find a clear answer" fallback, the
# question is recorded so you can find real gaps in the handbook coverage.
# No client identifiers are stored, and obvious emails/numbers are redacted.
# Node writes data/gaps.jsonl; the Worker writes to KV with a 90-day TTL.
# Review with `npm run gaps` (local) or `npm run gaps -- --remote` (Cloudflare).
# Set to false to disable entirely.
# -----------------------------------------------------------------------------
LOG_UNANSWERED_QUESTIONS=true
GAP_LOG_TTL_DAYS=90
